# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 流水线中间产物与原始数据（详设 §2.1）
scripts/.work/
materials/ielts/explanations.json
materials/ielts/.explanations-failed.json

# 本地 PGLite 数据目录
.pglite/

# 防御：PGlite 误把 :memory: 当路径的产物
:memory:/
