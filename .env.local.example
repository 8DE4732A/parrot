# 复制为 .env.local（本地开发）并在 Vercel/CI 配置同名变量

# ---- 数据库（Neon）----
DATABASE_URL=            # Neon connection string；本地开发可指向 Neon dev 分支

# ---- 鉴权（Auth.js + GitHub OAuth，M3 起使用）----
AUTH_SECRET=             # openssl rand -base64 32；兼作 API key 加密密钥源
AUTH_GITHUB_ID=          # GitHub OAuth App Client ID
AUTH_GITHUB_SECRET=      # GitHub OAuth App Client Secret
ALLOWED_GITHUB_LOGINS=   # 逗号分隔的 GitHub username 白名单

# ---- 默认 LLM（本地素材流水线 & 用户未配 key 时的兜底）----
# 本地网关：同时兼容 OpenAI 与 Anthropic 规范
DEFAULT_LLM_PROVIDER=openai-compatible
DEFAULT_LLM_BASE_URL=http://127.0.0.1:9002/v1
DEFAULT_LLM_MODEL=deepseek-v4-1-flash
DEFAULT_LLM_API_KEY=     # 本地网关如无需鉴权可留空
